{
  "name": "vortex-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Vortex extension exposing an MCP server for programmatic control of Vortex",
  "homepage": "https://github.com/alandtse/vortex-mcp#readme",
  "bugs": "https://github.com/alandtse/vortex-mcp/issues",
  "license": "GPL-3.0-only",
  "author": "Alan Tse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandtse/vortex-mcp.git"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.mjs lint",
    "lint:fix": "node scripts/check-source.mjs lint:fix",
    "format": "node scripts/check-source.mjs format",
    "format:check": "node scripts/check-source.mjs format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "install-plugin": "node scripts/install-local.mjs",
    "docs:tools": "node scripts/generate-readme-tools-table.mjs",
    "docs:tools:check": "node scripts/generate-readme-tools-table.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "2.9.1",
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "redux": "4.2.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.5",
      "hono": "4.13.14",
      "tinypool": "2.2.0"
    }
  }
}
