+/** Internal lifetime barrier. Main write availability must be restored BEFORE release. */
+export function acquireNativePersistenceFlushHold(): Promise<object> {
+  if (activeNativePersistenceHold === undefined) return Promise.reject(new Error("NATIVE_PERSISTENCE_HOLD_UNAVAILABLE"));
+  return activeNativePersistenceHold.acquire();
+}
+export function checkNativePersistenceFlushHold(owner: object): void {
+  if (activeNativePersistenceHold === undefined) throw new Error("NATIVE_PERSISTENCE_HOLD_UNAVAILABLE");
+  activeNativePersistenceHold.check(owner);
+}
+export function releaseNativePersistenceFlushHold(owner: object): void {
+  if (activeNativePersistenceHold === undefined) throw new Error("NATIVE_PERSISTENCE_HOLD_UNAVAILABLE");
+  activeNativePersistenceHold.release(owner);
+}
