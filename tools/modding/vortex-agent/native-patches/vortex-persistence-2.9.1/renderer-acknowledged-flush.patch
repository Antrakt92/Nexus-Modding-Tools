+/** Strict snapshot serialization: never turn an unsupported value into a remove. */
+function serializeAcknowledgedBatches(batches: PersistenceBatch[]): string {
+  if (batches.length > 32 || batches.reduce((sum, batch) => sum + batch.operations.length, 0) > 32768) {
+    throw new Error("Acknowledged persistence snapshot exceeds batch limit");
+  }
+  const active = new Set<object>();
