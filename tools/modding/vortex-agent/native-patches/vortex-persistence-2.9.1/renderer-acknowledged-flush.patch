+/**
+ * Acknowledge the detached pending snapshot and the main queue barrier.
+ * Concurrent callers share one flight. Failure/unknown outcome is held without
+ * replay. This does not freeze future renderer changes or grant installation.
+ */
+export function flushPendingDiffsAcknowledged(): Promise<void> {
+  if (activeAcknowledgedFlush === undefined) {
+    return Promise.reject(new Error("Acknowledged persistence middleware is unavailable"));
+  }
+  return activeAcknowledgedFlush();
+}
