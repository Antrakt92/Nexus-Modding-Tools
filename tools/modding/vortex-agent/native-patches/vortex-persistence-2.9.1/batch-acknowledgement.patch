+  /**
+   * Internal per-batch completion for a future owned registration path.
+   * This is not exposed over IPC and does not flush pending renderer diffs.
+   * A resolved queue drain alone cannot distinguish a failed batch.
+   */
+  public applyDiffOperationsAcknowledged(
+    hive: string,
+    operations: DiffOperation[],
+  ): Promise<void> {
+    try {
+      if (typeof hive !== "string" || hive.length === 0
+          || ["__proto__", "constructor", "prototype"].includes(hive)) {
+        throw new Error("Invalid acknowledged persistence hive");
+      }
+      // Detach before validation/enqueue: callers must not alter a waiting batch.
+      const snapshot = structuredClone(operations);
+      if (!Array.isArray(snapshot) || snapshot.length === 0) {
+        throw new Error("Acknowledged persistence requires a nonempty batch");
+      }
+      for (const op of snapshot) {
+        const keys = op == null ? [] : Object.keys(op);
+        if (op == null || !["set", "remove"].includes(op.type)
+            || keys.length !== (op.type === "set" ? 3 : 2)
+            || !Object.hasOwn(op, "type") || !Object.hasOwn(op, "path")
+            || (op.type === "set" && !Object.hasOwn(op, "value"))
+            || !Array.isArray(op.path) || op.path.length === 0) {
+          throw new Error("Invalid acknowledged persistence operation");
+        }
+        for (const segment of op.path) {
+          if (typeof segment !== "string" || segment.length === 0) {
+            throw new Error("Invalid acknowledged persistence path");
+          }
+        }
+      }
+      let persistor = Object.hasOwn(this.mPersistors, hive) ? this.mPersistors[hive] : undefined;
+      if (persistor === undefined && this.mPersistorFactory !== undefined) {
+        persistor = this.mPersistorFactory(hive);
+        if (persistor !== undefined) {
+          this.mPersistors[hive] = persistor;
+        }
+      }
+      if (persistor === undefined) {
+        return Promise.reject(new Error("Acknowledged persistence requires a registered hive"));
+      }
+      const owner = persistor;
+      const completion = this.mUpdateQueue.then(() =>
+        this.processOperations(hive, owner, snapshot, true),
+      );
+      // Keep the ordinary queue usable, without converting this caller's
+      // failed completion into a successful acknowledgement.
+      this.mUpdateQueue = completion.catch(() => undefined);
+      return completion;
+    } catch (err) {
+      return Promise.reject(err);
+    }
+  }
