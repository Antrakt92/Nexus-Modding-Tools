+// Join every already-started branch before propagating the first observed error.
+async function joinNativeLifecycle<T, R>(
+  items: T[],
+  action: (item: T, index: number) => R | PromiseLike<R>,
+): Promise<R[]> {
+  const values: R[] = new Array(items.length);
+  const started: Promise<void>[] = [];
+  let failed = false;
+  let firstError: unknown;
+  const fail = (error: unknown) => {
+    if (!failed) {
+      failed = true;
+      firstError = error;
+    }
+  };
+  items.forEach((item, index) => {
+    if (failed) return;
+    try {
+      started.push(Promise.resolve(action(item, index)).then(
+        (value) => { values[index] = value; },
+        fail,
+      ));
+    } catch (error) {
+      fail(error);
+    }
+  });
+  await Promise.all(started);
+  if (failed) throw firstError;
+  return values;
+}
