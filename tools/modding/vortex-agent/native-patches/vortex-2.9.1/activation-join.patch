+async function joinPurgeOperations(operations: Array<() => Promise<unknown>>): Promise<void> {
+  let failed = false;
+  let firstError: unknown;
+  const capture = (error: unknown) => {
+    if (!failed) {
+      failed = true;
+      firstError = error;
+    }
+  };
+  const started: Array<Promise<void>> = [];
+  for (const operation of operations) {
+    try {
+      started.push(Promise.resolve(operation()).then(() => undefined, capture));
+    } catch (error: unknown) {
+      capture(error);
+      break;
+    }
+  }
+  await Promise.all(started);
+  if (failed) {
+    throw firstError;
+  }
+}
