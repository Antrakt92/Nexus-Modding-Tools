+// Preserve Debouncer identity and its coalescing policy. Each submitted intent
+// owns a separate closure, while actual writers own the same shared registry.
+function ownDeploymentTimer<Args extends unknown[]>(timer: Debouncer<Args>): Debouncer<Args> {
+  const rawSchedule = timer.schedule.bind(timer);
+  const rawRunNow = timer.runNow.bind(timer);
+  const rawWait = timer.wait.bind(timer);
+  const submit = (
+    callback: ((error: Error | null) => void) | undefined,
+    enqueue: (done: (error: Error | null) => void) => void,
+  ): void => {
+    let delivered = false;
+    const notify = (error: Error | null): { failed: boolean; error?: unknown } => {
+      if (delivered) return { failed: false };
+      delivered = true;
+      try {
+        callback?.(error);
+        return { failed: false };
+      } catch (notificationError) {
+        try { log("warn", "Deployment callback failed"); } catch { /* Logging only. */ }
+        return { failed: true, error: notificationError };
+      }
+    };
+    try {
+      void InstallManager.trackNativeLifecycleCall(() => new Promise<void>((resolve, reject) => {
+        let returned = false;
+        let observed = false;
+        let failed = false;
+        let firstError: unknown;
+        const fail = (error: unknown) => {
+          if (!failed) { failed = true; firstError = error; }
+        };
+        const settle = () => { if (failed) reject(firstError); else resolve(); };
+        const done = (error: Error | null) => {
+          if (observed) return;
+          observed = true;
+          if (error !== null) fail(error);
+          const notice = notify(error);
+          if (notice.failed) fail(notice.error);
+          if (returned) settle();
+        };
+        try {
+          enqueue(done);
+          returned = true;
+          if (observed) settle();
+        } catch (error) {
+          // A synchronous success callback followed by startup failure cannot
+          // refund ownership. The original callback is never delivered twice.
+          fail(error);
+          reject(firstError);
+        }
+      })).catch((error) => { notify(error); });
+    } catch (error) {
+      notify(unknownToError(error));
+    }
+  };
+  timer.schedule = (callback, ...args) => submit(callback, (done) => rawSchedule(done, ...args));
+  timer.runNow = (callback, ...args) => submit(callback, (done) => rawRunNow(done, ...args));
+  timer.wait = (callback, immediately) => {
+    let delivered = false;
+    rawWait((error) => {
+      if (delivered) return;
+      delivered = true;
+      try { callback(error); } catch {
+        try { log("warn", "Deployment observer callback failed"); } catch { /* Logging only. */ }
+      }
+    }, immediately);
+  };
+  return timer;
+}
