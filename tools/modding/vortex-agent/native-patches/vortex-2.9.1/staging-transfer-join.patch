+// Observe every returned operation before propagating the first failure.
+function joinPathOperations<T, R>(
+  items: T[],
+  action: (item: T, index: number) => R | PromiseLike<R>,
+): PromiseBB<R[]> {
+  const values: R[] = new Array(items.length);
+  let failed = false;
+  let firstError: unknown;
+  return PromiseBB.map(items, (item, index) => {
+    if (failed) return PromiseBB.resolve();
+    return PromiseBB.try(() => action(item, index)).then(
+      (value) => { values[index] = value; },
+      (error) => {
+        if (!failed) {
+          failed = true;
+          firstError = error;
+        }
+      },
+    );
+  }).then(() => {
+    if (failed) throw firstError;
+    return values;
+  });
+}
